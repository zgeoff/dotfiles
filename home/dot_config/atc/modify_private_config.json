#!/bin/sh
# chezmoi owns agents.claude.env.CLOUD_FILES_URL and the sessionEnv.CLOUD_FILES_TOKEN_REF of each
# imp target. It deep-merges them over the live atc daemon config. Every other key stays as atc or the owner wrote
# it: targets, auth profiles, the other agents and the rest of agents.claude.
#
# The upload address is the same everywhere, so it sits on the agent entry, which atc passes to
# every Claude session it starts. The token reference differs by where the session runs:
# - An imp session reads 1Password through a Connect server that serves only the imp vault, so each
#   target with provider imp sets the imp vault's reference in its sessionEnv, which atc passes only
#   to sessions on that target.
# - A local session reads its reference from Claude settings: the repo's .claude/settings.local.json,
#   which op-mint points at the repo's vault, or ~/.claude/settings.json outside a repo. atc passes
#   its env in a --settings file, which outranks both, so the agent entry must not set the reference.
#   The script deletes it there.
# The script adds no target: a config without an imp target gets no reference.
#
# Every key of an earlier upload setting name is deleted by prefix, under agents.claude.env and each
# target's sessionEnv, so an existing config migrates.
# The token reference is the full op://<vault>/<item>/<field> of a 1Password item, never the token.
# An agent fills the token inline for one command:
#   CLOUD_FILES_TOKEN="$(op read "$CLOUD_FILES_TOKEN_REF")" bun verify publish --pr <n>
# Nothing runs `op run` over this environment, so the reference stays a plain string.
# The daemon reads this file only at start: restart it after a change.
set -eu
current=$(cat)
[ -n "$current" ] || current='{}'
printf '%s' "$current" | jq --indent 2 '
  def drop_earlier:
    with_entries(select(.key | (startswith("VERIFY_UPLOAD") or startswith("PR_EVIDENCE")) | not));
  del(.agents.claude.env.CLOUD_FILES_TOKEN_REF)
  | if (.agents.claude.env | type) == "object" then .agents.claude.env |= drop_earlier else . end
  * { "agents": { "claude": { "env": {
      "CLOUD_FILES_URL": "https://files.geoff.cloud/api/files"
    } } } }
  | if (.targets | type) == "object" then
      .targets |= with_entries(
        if (.value | type) == "object" and .value.provider == "imp" then
          (if (.value.sessionEnv | type) == "object" then .value.sessionEnv |= drop_earlier else . end)
          | .value.sessionEnv.CLOUD_FILES_TOKEN_REF = "op://imp/files-upload-token/credential"
        elif (.value | type) == "object" and (.value.sessionEnv | type) == "object" then
          .value.sessionEnv |= drop_earlier
        else
          .
        end
      )
    else
      .
    end
'
