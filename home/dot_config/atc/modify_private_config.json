#!/bin/sh
# chezmoi owns agents.claude.env.PR_EVIDENCE_URL and agents.claude.env.PR_EVIDENCE_TOKEN_PATH, and
# deep-merges them over the live atc daemon config. Every other key stays as atc or the owner wrote
# it: targets, auth profiles, the other agents and the rest of agents.claude. The daemon passes
# agents.claude.env to every Claude session it starts, local and imp alike.
# The token path is <vault>/<item>/<field> of a 1Password item, never the token. It has no op://
# prefix: `op run` resolves every op:// value in its environment, and fails when the session's token
# can't read the vault.
set -eu
current=$(cat)
[ -n "$current" ] || current='{}'
printf '%s' "$current" | jq --indent 2 'del(.agents.claude.env.PR_EVIDENCE_TOKEN_REF) * {
  "agents": {
    "claude": {
      "env": {
        "PR_EVIDENCE_URL": "https://files.geoff.cloud/api/files",
        "PR_EVIDENCE_TOKEN_PATH": "zgeoff/files-agent-token/credential"
      }
    }
  }
}'
