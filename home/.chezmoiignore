# package manifests: consumed by .chezmoiscripts, never deployed
packages
packages/**

{{ if not .gui }}
# terminal emulators need a display server
.config/kitty
.config/kitty/**
.config/ghostty
.config/ghostty/**
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.config/mpd
.config/mpd/**
.config/ncmpcpp
.config/ncmpcpp/**
.config/vis
.config/vis/**
{{ end }}

{{ if not .arch }}
.config/pacman
.config/pacman/**
.config/yay
.config/yay/**
{{ end }}

{{ if not .wsl }}
# launches the Windows-hosted Zed; meaningless outside WSL
.local/bin/zed
{{ end }}

{{ if not (and (hasKey . "personal") .personal) }}
# mints tokens against the personal 1Password account; personal machines only
.local/bin/op-mint
# Codex/Grok delegation sends code to OpenAI/xAI; personal machines only
.claude/skills/delegate
.claude/skills/delegate/**
{{ end }}
