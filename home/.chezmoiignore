# package manifests: consumed by .chezmoiscripts, never deployed
packages
packages/**

{{ if not .gui }}
# terminal emulators need a display server
.config/kitty
.config/kitty/**
.config/ghostty
.config/ghostty/**
{{ end }}

{{ if ne .chezmoi.os "linux" }}
.config/mpd
.config/mpd/**
.config/ncmpcpp
.config/ncmpcpp/**
.config/vis
.config/vis/**
{{ end }}

{{ if not .arch }}
.config/pacman
.config/pacman/**
.config/yay
.config/yay/**
{{ end }}

{{ if not .wsl }}
# launches the Windows-hosted Zed; meaningless outside WSL
.local/bin/zed
{{ end }}

{{ if not (and (hasKey . "personal") .personal) }}
# Personal machines only. tests/machine-split.test.js reads this block.
# mints tokens against the personal 1Password account
.local/bin/op-mint
# read the machine user's key and token from the personal 1Password account
.local/bin/agent-identity
.local/bin/agent-onboard
# the personal file drop, and its config
.local/bin/cloud
.config/cloud
.config/cloud/**
# personal infrastructure
.local/bin/nixie
.config/nixie
.config/nixie/**
# rotates the personal Claude account slots
.claude/skills/claude-account-switch
.claude/skills/claude-account-switch/**
# MCP headers helpers read the personal 1Password account
.claude/mcp-helpers
.claude/mcp-helpers/**
# points each Claude session that atc starts at the personal file drop
.config/atc/config.json
{{ end }}
