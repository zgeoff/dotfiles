#!/usr/bin/env bun

// nixie: small helpers for the nixie deployment (enrol a device, check it, read its log, reset it).
// The host, domain, namespace and cloud checkout come from ~/.config/nixie/cli.toml
// (or $NIXIE_CLI_CONFIG); `nixie help` says how to create it.
//
// Add a command: one entry in `commands` below, with a summary and an async run(args).

import { existsSync, readFileSync } from 'node:fs';
import { homedir } from 'node:os';
import { join } from 'node:path';

const home = homedir();
const configPath = process.env.NIXIE_CLI_CONFIG || join(home, '.config/nixie/cli.toml');
const examplePath = join(home, '.config/nixie/cli.example.toml');

const useColour = process.stdout.isTTY && !process.env.NO_COLOR;
const paint = (code) => (text) => (useColour ? `\x1b[${code}m${text}\x1b[0m` : text);
const green = paint('32');
const red = paint('31');
const yellow = paint('33');
const dim = paint('2');
const bold = paint('1');

class Failure extends Error {}

const fail = (message) => {
  throw new Failure(message);
};

// ---------------------------------------------------------------------------------------- config

const requiredKeys = ['host', 'domain', 'namespace', 'cloud_dir'];

function loadConfig() {
  if (!existsSync(configPath)) {
    fail(
      [
        `no config at ${configPath}`,
        '',
        'create it from the example, then fill in the placeholders:',
        `  mkdir -p ${join(home, '.config/nixie')}`,
        `  cp ${examplePath} ${configPath}`,
        '',
        'keys: host (ssh destination), domain (nixie web name), namespace (k8s namespace),',
        '      cloud_dir (checkout with the nixie:reset script); optional pod, container',
      ].join('\n'),
    );
  }

  let parsed;
  try {
    parsed = Bun.TOML.parse(readFileSync(configPath, 'utf8'));
  } catch (error) {
    fail(`cannot parse ${configPath}: ${error.message}`);
  }

  const missing = requiredKeys.filter((key) => typeof parsed[key] !== 'string' || parsed[key] === '');
  if (missing.length > 0) {
    fail(`${configPath} is missing ${missing.join(', ')} (see ${examplePath})`);
  }

  return {
    host: parsed.host,
    domain: parsed.domain,
    namespace: parsed.namespace,
    cloudDir: parsed.cloud_dir.replace(/^~(?=\/|$)/, home),
    pod: parsed.pod || 'nixie-0',
    container: parsed.container || 'nixie',
  };
}

// ---------------------------------------------------------------------------------------- remote

// ssh joins its arguments into one remote shell line, so every value goes in single quotes
const shq = (value) => `'${String(value).replaceAll("'", "'\\''")}'`;

const kubectl = (config, ...args) =>
  ['k3s', 'kubectl', '-n', shq(config.namespace), ...args].join(' ');

const podExec = (config, ...args) =>
  kubectl(config, 'exec', shq(config.pod), '-c', shq(config.container), '--', ...args);

// runs one remote line and returns its output
async function capture(config, line) {
  const proc = Bun.spawn(['ssh', config.host, line], {
    stdin: 'ignore',
    stdout: 'pipe',
    stderr: 'pipe',
  });
  const [stdout, stderr, exitCode] = await Promise.all([
    new Response(proc.stdout).text(),
    new Response(proc.stderr).text(),
    proc.exited,
  ]);
  return { stdout, stderr, exitCode };
}

// runs one remote line on this terminal and returns its exit code
async function attach(config, line, { tty = false } = {}) {
  const proc = Bun.spawn(['ssh', ...(tty ? ['-t'] : []), config.host, line], {
    stdio: ['inherit', 'inherit', 'inherit'],
  });
  return proc.exited;
}

// ---------------------------------------------------------------------------------------- enrol

// enrol-code prints the code, then "The code works once, until <ISO time>."
export function parseEnrolment(stdout) {
  const lines = stdout.trim().split('\n');
  const code = lines[0]?.trim();
  const iso = stdout.match(/\d{4}-\d{2}-\d{2}T[\d:.]+Z/)?.[0];
  const expiresAt = iso ? new Date(iso) : undefined;
  return code ? { code, expiresAt } : undefined;
}

async function copyToClipboard(text) {
  if (!Bun.which('clip')) {
    return false;
  }
  try {
    const proc = Bun.spawn(['clip'], { stdin: new Blob([text]), stdout: 'ignore', stderr: 'ignore' });
    return (await proc.exited) === 0;
  } catch {
    return false;
  }
}

async function enrol() {
  const config = loadConfig();
  const result = await capture(config, podExec(config, 'bun', '/app/main.js', 'enrol-code'));
  if (result.exitCode !== 0) {
    fail(`enrol-code failed (exit ${result.exitCode}): ${result.stderr.trim()}`);
  }

  const enrolment = parseEnrolment(result.stdout);
  if (!enrolment) {
    fail(`enrol-code printed no code:\n${result.stdout}`);
  }

  const copied = await copyToClipboard(enrolment.code);
  console.log(`  ${bold(enrolment.code)}${copied ? dim('  (copied)') : ''}`);
  console.log(`  open   https://${config.domain}`);
  if (enrolment.expiresAt) {
    const minutes = Math.round((enrolment.expiresAt - Date.now()) / 60_000);
    console.log(`  until  ${enrolment.expiresAt.toLocaleString()} ${dim(`(${minutes} min, works once)`)}`);
  } else {
    console.log(dim(result.stdout.trim().split('\n').slice(1).join('\n')));
  }
  return 0;
}

// ---------------------------------------------------------------------------------------- status

// fetched inside the pod, where the server answers on loopback
const readyScript =
  'const r = await fetch("http://127.0.0.1:8080/health/ready"); console.log(JSON.stringify({ status: r.status, body: await r.text() }))';

async function status() {
  const config = loadConfig();
  const result = await capture(config, podExec(config, 'bun', '-e', shq(readyScript)));
  if (result.exitCode !== 0) {
    console.log(`${red('✗')} pod      ${result.stderr.trim() || `exec failed (exit ${result.exitCode})`}`);
    return 1;
  }

  let report;
  try {
    const { body } = JSON.parse(result.stdout.trim().split('\n').at(-1));
    report = JSON.parse(body);
  } catch {
    fail(`unexpected readiness output:\n${result.stdout}`);
  }

  const parts = Object.entries(report.parts ?? {});
  const width = Math.max(0, ...parts.map(([name]) => name.length));
  for (const [name, part] of parts) {
    const mark = part.isReady ? green('✓') : red('✗');
    const reason = part.reason ? `  ${yellow(part.reason)}` : '';
    console.log(`${mark} ${name.padEnd(width)}  ${part.isReady ? green('ready') : red('unready')}${reason}`);
  }
  console.log(dim(`nixie is ${report.status}`));
  return report.status === 'ready' ? 0 : 1;
}

// ---------------------------------------------------------------------------------------- logs

async function logs(args) {
  const follow = args.includes('-f') || args.includes('--follow');
  const unknown = args.filter((arg) => !['-f', '--follow'].includes(arg));
  if (unknown.length > 0) {
    fail(`logs: unknown argument ${unknown[0]}\nusage: nixie logs [-f]`);
  }

  const config = loadConfig();
  const line = kubectl(config, 'logs', shq(config.pod), '-c', shq(config.container), ...(follow ? ['-f'] : []));
  // a remote tty makes Ctrl-C stop kubectl on the host too
  return attach(config, line, { tty: follow && process.stdin.isTTY });
}

// ---------------------------------------------------------------------------------------- reset

// The reset lives in the cloud checkout; this only picks the flag and asks before --confirm.
async function reset(args) {
  const confirm = args.includes('--confirm');
  const unknown = args.filter((arg) => !['--confirm', '--dry-run'].includes(arg));
  if (unknown.length > 0) {
    fail(`reset: unknown argument ${unknown[0]}\nusage: nixie reset [--confirm]`);
  }
  if (confirm && args.includes('--dry-run')) {
    fail('reset: pick one of --confirm and --dry-run\nusage: nixie reset [--confirm]');
  }

  const config = loadConfig();
  const packagePath = join(config.cloudDir, 'package.json');
  if (!existsSync(packagePath)) {
    fail(`no package.json in cloud_dir ${config.cloudDir}`);
  }
  if (!JSON.parse(readFileSync(packagePath, 'utf8')).scripts?.['nixie:reset']) {
    fail(`${config.cloudDir} has no nixie:reset script; pull its main branch`);
  }

  if (confirm) {
    if (!process.stdin.isTTY) {
      fail('reset: --confirm needs a terminal to type "reset" in; nothing changed');
    }
    console.log(red('this deletes all of nixie\'s data and signs out every device; it cannot be undone'));
    const answer = prompt('type "reset" to go on:');
    if (answer?.trim() !== 'reset') {
      fail('reset: not confirmed; nothing changed');
    }
  }

  const proc = Bun.spawn(['bun', 'run', 'nixie:reset', confirm ? '--confirm' : '--dry-run'], {
    cwd: config.cloudDir,
    stdio: ['inherit', 'inherit', 'inherit'],
  });
  return proc.exited;
}

// ---------------------------------------------------------------------------------------- memory

// The pod's memory-* host commands answer through nixie's control socket and print one JSON line.
// The proposed text is printed here, to this terminal only; nothing logs it.
async function runMemoryCommand(config, ...args) {
  const result = await capture(config, podExec(config, 'bun', '/app/main.js', ...args.map(shq)));
  const lastLine = result.stdout.trim().split('\n').at(-1) ?? '';
  if (result.exitCode !== 0) {
    fail(`${args[0]} failed (exit ${result.exitCode}): ${readFailure(lastLine) ?? result.stderr.trim()}`);
  }
  try {
    return JSON.parse(lastLine);
  } catch {
    fail(`${args[0]} printed no JSON:\n${result.stdout}`);
  }
}

// a failed host command logs command.failed with the server's reason
function readFailure(line) {
  try {
    return JSON.parse(line).message;
  } catch {
    return line || undefined;
  }
}

export function formatAge(fromISO, now = Date.now()) {
  const minutes = Math.max(0, Math.floor((now - new Date(fromISO)) / 60_000));
  const days = Math.floor(minutes / 1440);
  const hours = Math.floor((minutes % 1440) / 60);
  if (days > 0) return `${days}d ${hours}h`;
  if (hours > 0) return `${hours}h ${minutes % 60}m`;
  return `${minutes}m`;
}

export function formatKind(proposal) {
  const target = proposal.targetVersion === null ? 'new item' : `v${proposal.targetVersion}`;
  return `${proposal.operation} ${target}${proposal.isPinned ? ' (pinned)' : ''}`;
}

// Proposal text can come from untrusted content, so a control character prints escaped: an escape
// sequence must not redraw the text the confirmation shows. Newlines stay.
export function escapeControls(value) {
  return String(value).replace(
    /[\u0000-\u0009\u000b-\u001f\u007f-\u009f]/g,
    (char) => `\\x${char.charCodeAt(0).toString(16).padStart(2, '0')}`,
  );
}

// a labelled block of text, each line after the first indented under the first
const formatBlock = (label, value, style = (line) => line) =>
  escapeControls(value)
    .split('\n')
    .map((line, index) => `  ${index === 0 ? label.padEnd(7) : '       '} ${style(line)}`);

export function formatProposal(proposal, now = Date.now()) {
  const lapsesIn = formatAge(new Date(now).toISOString(), Date.parse(proposal.lapseAt));
  return [
    `${bold(escapeControls(proposal.proposalID))}`,
    `  kind    ${escapeControls(formatKind(proposal))}`,
    `  reason  ${escapeControls(proposal.reason)}`,
    `  age     ${formatAge(proposal.createdAt, now)} ${dim(`(lapses in ${lapsesIn})`)}`,
    `  source  ${escapeControls(`${proposal.origin}, ${proposal.source}`)}`,
    ...formatBlock('text', proposal.text),
    ...(proposal.quote === null ? [] : formatBlock('quote', proposal.quote, dim)),
  ].join('\n');
}

// An ID, or with a confirmation a unique prefix of at least 8 characters. --yes takes the full ID,
// because a prefix could match a proposal that arrived after the listing the user read.
export function findProposal(pending, id, { exact = false } = {}) {
  if (exact ? id.length < 36 : id.length < 8) {
    fail(exact ? '--yes takes the full proposal ID' : 'give at least 8 characters of the proposal ID');
  }
  const matches = pending.filter((proposal) =>
    exact ? proposal.proposalID === id : proposal.proposalID.startsWith(id),
  );
  if (matches.length === 0) {
    fail(`no pending memory proposal ${id}; run nixie memory pending`);
  }
  if (matches.length > 1) {
    fail(`${id} matches ${matches.length} pending proposals; give more of the ID`);
  }
  return matches[0];
}

async function memoryPending(config) {
  const pending = await runMemoryCommand(config, 'memory-pending');
  if (pending.length === 0) {
    console.log(dim('no memory proposal waits for an answer'));
    return 0;
  }
  console.log(pending.map((proposal) => formatProposal(proposal)).join('\n\n'));
  console.log(dim(`\n${pending.length} pending; answer with nixie memory approve|reject <id>`));
  return 0;
}

// -y/--yes and --text <text> (or --text=<text>) anywhere; every other argument is positional
export function parseMemoryArgs(args) {
  const parsed = { yes: false, text: undefined, positionals: [] };
  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === '-y' || arg === '--yes') {
      parsed.yes = true;
    } else if (arg === '--text') {
      if (index + 1 >= args.length) {
        fail('--text takes the text');
      }
      parsed.text = args[(index += 1)];
    } else if (arg.startsWith('--text=')) {
      parsed.text = arg.slice('--text='.length);
    } else if (arg.startsWith('-') && arg !== '-') {
      fail(`unknown option ${arg}`);
    } else {
      parsed.positionals.push(arg);
    }
  }
  if (parsed.text !== undefined && parsed.text.trim() === '') {
    fail('--text takes the text, and blank text replaces nothing');
  }
  return parsed;
}

// asks on the terminal unless --yes; nothing changes without a yes
function confirm(question, what, yes) {
  if (yes) {
    return;
  }
  if (!process.stdin.isTTY) {
    fail(`${what}: needs a terminal to confirm, or --yes; nothing changed`);
  }
  const reply = prompt(`\n${question} [y/N]`);
  if (!['y', 'yes'].includes(reply?.trim().toLowerCase())) {
    fail(`${what}: not confirmed; nothing changed`);
  }
}

// The answer binds to the action hash of the proposal shown here, so a proposal that changed since
// this listing refuses it and nothing applies. --text approves the proposal with your own text.
async function memoryAnswer(config, answer, args) {
  const { yes, text, positionals } = parseMemoryArgs(args);
  if (positionals.length !== 1 || (answer === 'reject' && text !== undefined)) {
    fail(
      answer === 'approve'
        ? 'usage: nixie memory approve <id> [--text <edited text>] [--yes]'
        : 'usage: nixie memory reject <id> [--yes]',
    );
  }

  const pending = await runMemoryCommand(config, 'memory-pending');
  const proposal = findProposal(pending, positionals[0], { exact: yes });
  console.log(formatProposal(proposal));
  if (text !== undefined) {
    console.log(formatBlock('yours', text, bold).join('\n'));
  }
  const question = text === undefined ? `${answer} this proposal?` : 'approve it with your text?';
  confirm(question, `memory ${answer}`, yes);

  const result = await runMemoryCommand(
    config,
    `memory-${answer}`,
    proposal.proposalID,
    '--hash',
    proposal.actionHash,
    ...(text === undefined ? [] : [`--text=${text}`]),
  );
  console.log(`${green('✓')} ${formatAnswerOutcome(answer, result)}`);
  return 0;
}

// an approval the server holds for a close match applies nothing; it prints the match instead
export function formatAnswerOutcome(answer, result) {
  if (answer === 'reject') {
    return 'rejected';
  }
  if (result.status === 'close_match') {
    return `held: it closely matches ${result.item.itemID} v${result.item.version}`;
  }
  return `approved as ${result.itemID} v${result.version}`;
}

// What `memory show` prints: the item's state, then each version oldest first. A version whose key
// is gone prints its status instead of its text.
export function formatItem(item) {
  const versions = item.versions.flatMap((version) => [
    `  ${bold(`v${version.version}`)} ${escapeControls(`${version.change}, ${version.state}`)} ${dim(
      escapeControls(`by ${version.origin}, ${version.source}, ${version.recordedAt}`),
    )}`,
    ...(version.status === 'readable'
      ? formatBlock('', version.text).map((line) => `  ${line}`)
      : [`    ${dim(`(${escapeControls(version.status)})`)}`]),
  ]);
  return [`${bold(escapeControls(item.itemID))} ${escapeControls(item.state)}`, ...versions].join('\n');
}

// <itemID> or <itemID>@<version>; an item ID is the full ID that `memory show` prints
export function parseItemTarget(target) {
  const match = /^([0-9a-f-]{36})(?:@([1-9]\d*))?$/.exec(target ?? '');
  if (!match) {
    fail('give the full item ID, or <item ID>@<version>');
  }
  return { itemID: match[1], version: match[2] === undefined ? undefined : Number(match[2]) };
}

async function memoryShow(config, args) {
  const { positionals } = parseMemoryArgs(args);
  if (positionals.length !== 1) {
    fail('usage: nixie memory show <item ID>');
  }
  const { itemID } = parseItemTarget(positionals[0]);
  console.log(formatItem(await runMemoryCommand(config, 'memory-show', itemID)));
  return 0;
}

// An edit, a retirement or a restore binds to a version: the one named as <itemID>@<version>, or
// else the current one shown here, so a change that lands in between refuses it and nothing applies.
async function memoryChange(config, change, args) {
  const { yes, text, positionals } = parseMemoryArgs(args);
  const usage =
    change === 'edit'
      ? 'usage: nixie memory edit <item ID>[@<version>] --text <new text> [--yes]'
      : `usage: nixie memory ${change} <item ID>[@<version>] [--yes]`;
  if (positionals.length !== 1 || (change === 'edit') !== (text !== undefined)) {
    fail(usage);
  }

  const target = parseItemTarget(positionals[0]);
  const item = await runMemoryCommand(config, 'memory-show', target.itemID);
  const current = item.versions.at(-1);
  const version = target.version ?? current.version;
  console.log(formatItem(item));
  if (text !== undefined) {
    console.log(`\n${formatBlock('new', text, bold).join('\n')}`);
  }
  confirm(`${change} v${version} of this item?`, `memory ${change}`, yes);

  const result = await runMemoryCommand(
    config,
    `memory-${change}`,
    `${target.itemID}@${version}`,
    ...(text === undefined ? [] : [`--text=${text}`]),
  );
  console.log(`${green('✓')} ${change === 'edit' ? 'edited' : `${change}d`}: now v${result.version}`);
  return 0;
}

// A pin adds no version and can be undone at once, so it asks nothing.
async function memoryPin(config, isPinned, args) {
  const { positionals } = parseMemoryArgs(args);
  if (positionals.length !== 1) {
    fail(`usage: nixie memory ${isPinned ? 'pin' : 'unpin'} <item ID>`);
  }
  const { itemID } = parseItemTarget(positionals[0]);
  await runMemoryCommand(config, `memory-${isPinned ? 'pin' : 'unpin'}`, itemID);
  console.log(`${green('✓')} ${isPinned ? 'pinned' : 'unpinned'} ${itemID}`);
  return 0;
}

const memoryUsage = [
  'usage: nixie memory pending | approve <id> [--text <edited text>] [--yes] | reject <id> [--yes]',
  '       nixie memory show <item ID> | edit <item ID>[@<version>] --text <new text> [--yes]',
  '       nixie memory retire|restore <item ID>[@<version>] [--yes] | pin|unpin <item ID>',
].join('\n');

async function memory(args) {
  const [sub, ...rest] = args;
  if (sub === 'pending') {
    if (rest.length > 0) {
      fail(`memory pending: unknown argument ${rest[0]}\n${memoryUsage}`);
    }
    return memoryPending(loadConfig());
  }
  if (sub === 'approve' || sub === 'reject') {
    return memoryAnswer(loadConfig(), sub, rest);
  }
  if (sub === 'show') {
    return memoryShow(loadConfig(), rest);
  }
  if (sub === 'edit' || sub === 'retire' || sub === 'restore') {
    return memoryChange(loadConfig(), sub, rest);
  }
  if (sub === 'pin' || sub === 'unpin') {
    return memoryPin(loadConfig(), sub === 'pin', rest);
  }
  fail(sub === undefined ? memoryUsage : `memory: unknown subcommand ${sub}\n${memoryUsage}`);
}

// ---------------------------------------------------------------------------------------- help

function help() {
  const width = Math.max(...Object.values(commands).map((command) => command.usage.length));
  console.log(`${bold('✿ nixie')} ${dim('· little helpers for the nixie deployment')}\n`);
  for (const command of Object.values(commands)) {
    console.log(`  nixie ${command.usage.padEnd(width)}  ${command.summary}`);
  }
  console.log(`\n${dim(`config: ${configPath}${existsSync(configPath) ? '' : ' (missing: run any command to see how to create it)'}`)}`);
  return 0;
}

const commands = {
  enrol: { usage: 'enrol', summary: 'mint an enrolment code and copy it to the clipboard', run: enrol },
  status: { usage: 'status', summary: 'show each readiness part', run: status },
  logs: { usage: 'logs [-f]', summary: "print nixie's pod log; -f follows it", run: logs },
  memory: {
    usage: 'memory <subcommand>',
    summary: 'answer memory proposals; show, edit, retire, restore or pin an item',
    run: memory,
  },
  reset: { usage: 'reset [--confirm]', summary: 'dry-run the factory reset; --confirm runs it', run: reset },
  help: { usage: 'help', summary: 'show this list', run: help },
};

async function main(argv) {
  const [name = 'help', ...args] = argv;
  const command = commands[name] ?? (['-h', '--help'].includes(name) ? commands.help : undefined);
  if (!command) {
    console.error(`nixie: unknown command ${name}\n`);
    help();
    return 2;
  }
  try {
    return await command.run(args);
  } catch (error) {
    if (error instanceof Failure) {
      console.error(`${red('nixie:')} ${error.message}`);
      return 1;
    }
    throw error;
  }
}

if (import.meta.main) {
  process.exitCode = await main(process.argv.slice(2));
}
