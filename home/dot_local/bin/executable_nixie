#!/usr/bin/env bun

// nixie: small helpers for the nixie deployment (enrol a device, check it, read its log, reset it).
// The host, domain, namespace and cloud checkout come from ~/.config/nixie/cli.toml
// (or $NIXIE_CLI_CONFIG); `nixie help` says how to create it.
//
// Add a command: one entry in `commands` below, with a summary and an async run(args).

import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { homedir, tmpdir } from 'node:os';
import { dirname, join, normalize } from 'node:path';

const home = homedir();
const configPath = process.env.NIXIE_CLI_CONFIG || join(home, '.config/nixie/cli.toml');
const examplePath = join(home, '.config/nixie/cli.example.toml');

const useColour = process.stdout.isTTY && !process.env.NO_COLOR;
const paint = (code) => (text) => (useColour ? `\x1b[${code}m${text}\x1b[0m` : text);
const green = paint('32');
const red = paint('31');
const yellow = paint('33');
const dim = paint('2');
const bold = paint('1');

export class Failure extends Error {}

const fail = (message) => {
  throw new Failure(message);
};

// ---------------------------------------------------------------------------------------- config

const requiredKeys = ['host', 'domain', 'namespace', 'cloud_dir'];

function loadConfig() {
  if (!existsSync(configPath)) {
    fail(
      [
        `no config at ${configPath}`,
        '',
        'create it from the example, then fill in the placeholders:',
        `  mkdir -p ${join(home, '.config/nixie')}`,
        `  cp ${examplePath} ${configPath}`,
        '',
        'keys: host (ssh destination), domain (nixie web name), namespace (k8s namespace),',
        '      cloud_dir (checkout with the nixie:reset script); optional pod, container',
      ].join('\n'),
    );
  }

  let parsed;
  try {
    parsed = Bun.TOML.parse(readFileSync(configPath, 'utf8'));
  } catch (error) {
    fail(`cannot parse ${configPath}: ${error.message}`);
  }

  const missing = requiredKeys.filter((key) => typeof parsed[key] !== 'string' || parsed[key] === '');
  if (missing.length > 0) {
    fail(`${configPath} is missing ${missing.join(', ')} (see ${examplePath})`);
  }

  return {
    host: parsed.host,
    domain: parsed.domain,
    namespace: parsed.namespace,
    cloudDir: parsed.cloud_dir.replace(/^~(?=\/|$)/, home),
    pod: parsed.pod || 'nixie-0',
    container: parsed.container || 'nixie',
  };
}

// ---------------------------------------------------------------------------------------- remote

// ssh joins its arguments into one remote shell line, so every value goes in single quotes
const shq = (value) => `'${String(value).replaceAll("'", "'\\''")}'`;

const kubectl = (config, ...args) =>
  ['k3s', 'kubectl', '-n', shq(config.namespace), ...args].join(' ');

const podExec = (config, ...args) =>
  kubectl(config, 'exec', shq(config.pod), '-c', shq(config.container), '--', ...args);

// runs one remote line and returns its output
async function capture(config, line) {
  const proc = Bun.spawn(['ssh', config.host, line], {
    stdin: 'ignore',
    stdout: 'pipe',
    stderr: 'pipe',
  });
  const [stdout, stderr, exitCode] = await Promise.all([
    new Response(proc.stdout).text(),
    new Response(proc.stderr).text(),
    proc.exited,
  ]);
  return { stdout, stderr, exitCode };
}

// runs one remote line on this terminal and returns its exit code
async function attach(config, line, { tty = false } = {}) {
  const proc = Bun.spawn(['ssh', ...(tty ? ['-t'] : []), config.host, line], {
    stdio: ['inherit', 'inherit', 'inherit'],
  });
  return proc.exited;
}

// ---------------------------------------------------------------------------------------- enrol

// enrol-code prints the code, then "The code works once, until <ISO time>."
export function parseEnrolment(stdout) {
  const lines = stdout.trim().split('\n');
  const code = lines[0]?.trim();
  const iso = stdout.match(/\d{4}-\d{2}-\d{2}T[\d:.]+Z/)?.[0];
  const expiresAt = iso ? new Date(iso) : undefined;
  return code ? { code, expiresAt } : undefined;
}

async function copyToClipboard(text) {
  if (!Bun.which('clip')) {
    return false;
  }
  try {
    const proc = Bun.spawn(['clip'], { stdin: new Blob([text]), stdout: 'ignore', stderr: 'ignore' });
    return (await proc.exited) === 0;
  } catch {
    return false;
  }
}

async function enrol() {
  const config = loadConfig();
  const result = await capture(config, podExec(config, 'bun', '/app/main.js', 'enrol-code'));
  if (result.exitCode !== 0) {
    fail(`enrol-code failed (exit ${result.exitCode}): ${result.stderr.trim()}`);
  }

  const enrolment = parseEnrolment(result.stdout);
  if (!enrolment) {
    fail(`enrol-code printed no code:\n${result.stdout}`);
  }

  const copied = await copyToClipboard(enrolment.code);
  console.log(`  ${bold(enrolment.code)}${copied ? dim('  (copied)') : ''}`);
  console.log(`  open   https://${config.domain}`);
  if (enrolment.expiresAt) {
    const minutes = Math.round((enrolment.expiresAt - Date.now()) / 60_000);
    console.log(`  until  ${enrolment.expiresAt.toLocaleString()} ${dim(`(${minutes} min, works once)`)}`);
  } else {
    console.log(dim(result.stdout.trim().split('\n').slice(1).join('\n')));
  }
  return 0;
}

// ---------------------------------------------------------------------------------------- status

// fetched inside the pod, where the server answers on loopback
const readyScript =
  'const r = await fetch("http://127.0.0.1:8080/health/ready"); console.log(JSON.stringify({ status: r.status, body: await r.text() }))';

async function status() {
  const config = loadConfig();
  const result = await capture(config, podExec(config, 'bun', '-e', shq(readyScript)));
  if (result.exitCode !== 0) {
    console.log(`${red('✗')} pod      ${result.stderr.trim() || `exec failed (exit ${result.exitCode})`}`);
    return 1;
  }

  let report;
  try {
    const { body } = JSON.parse(result.stdout.trim().split('\n').at(-1));
    report = JSON.parse(body);
  } catch {
    fail(`unexpected readiness output:\n${result.stdout}`);
  }

  const parts = Object.entries(report.parts ?? {});
  const width = Math.max(0, ...parts.map(([name]) => name.length));
  for (const [name, part] of parts) {
    const mark = part.isReady ? green('✓') : red('✗');
    const reason = part.reason ? `  ${yellow(part.reason)}` : '';
    console.log(`${mark} ${name.padEnd(width)}  ${part.isReady ? green('ready') : red('unready')}${reason}`);
  }
  console.log(dim(`nixie is ${report.status}`));
  return report.status === 'ready' ? 0 : 1;
}

// ---------------------------------------------------------------------------------------- logs

async function logs(args) {
  const follow = args.includes('-f') || args.includes('--follow');
  const unknown = args.filter((arg) => !['-f', '--follow'].includes(arg));
  if (unknown.length > 0) {
    fail(`logs: unknown argument ${unknown[0]}\nusage: nixie logs [-f]`);
  }

  const config = loadConfig();
  const line = kubectl(config, 'logs', shq(config.pod), '-c', shq(config.container), ...(follow ? ['-f'] : []));
  // a remote tty makes Ctrl-C stop kubectl on the host too
  return attach(config, line, { tty: follow && process.stdin.isTTY });
}

// ---------------------------------------------------------------------------------------- reset

// The reset lives in the cloud checkout; this only picks the flag and asks before --confirm.
async function reset(args) {
  const confirm = args.includes('--confirm');
  const unknown = args.filter((arg) => !['--confirm', '--dry-run'].includes(arg));
  if (unknown.length > 0) {
    fail(`reset: unknown argument ${unknown[0]}\nusage: nixie reset [--confirm]`);
  }
  if (confirm && args.includes('--dry-run')) {
    fail('reset: pick one of --confirm and --dry-run\nusage: nixie reset [--confirm]');
  }

  const config = loadConfig();
  const packagePath = join(config.cloudDir, 'package.json');
  if (!existsSync(packagePath)) {
    fail(`no package.json in cloud_dir ${config.cloudDir}`);
  }
  if (!JSON.parse(readFileSync(packagePath, 'utf8')).scripts?.['nixie:reset']) {
    fail(`${config.cloudDir} has no nixie:reset script; pull its main branch`);
  }

  if (confirm) {
    if (!process.stdin.isTTY) {
      fail('reset: --confirm needs a terminal to type "reset" in; nothing changed');
    }
    console.log(red('this deletes all of nixie\'s data and signs out every device; it cannot be undone'));
    const answer = prompt('type "reset" to go on:');
    if (answer?.trim() !== 'reset') {
      fail('reset: not confirmed; nothing changed');
    }
  }

  const proc = Bun.spawn(['bun', 'run', 'nixie:reset', confirm ? '--confirm' : '--dry-run'], {
    cwd: config.cloudDir,
    stdio: ['inherit', 'inherit', 'inherit'],
  });
  return proc.exited;
}

// ---------------------------------------------------------------------------------------- memory

// The pod's memory-* host commands answer through nixie's control socket and print one JSON line.
// The proposed text is printed here, to this terminal only; nothing logs it.
async function runMemoryCommand(config, ...args) {
  const result = await capture(config, podExec(config, 'bun', '/app/main.js', ...args.map(shq)));
  const lastLine = result.stdout.trim().split('\n').at(-1) ?? '';
  if (result.exitCode !== 0) {
    fail(`${args[0]} failed (exit ${result.exitCode}): ${readFailure(lastLine) ?? result.stderr.trim()}`);
  }
  try {
    return JSON.parse(lastLine);
  } catch {
    fail(`${args[0]} printed no JSON:\n${result.stdout}`);
  }
}

// a failed host command logs command.failed with the server's reason
function readFailure(line) {
  try {
    return JSON.parse(line).message;
  } catch {
    return line || undefined;
  }
}

export function formatAge(fromISO, now = Date.now()) {
  const minutes = Math.max(0, Math.floor((now - new Date(fromISO)) / 60_000));
  const days = Math.floor(minutes / 1440);
  const hours = Math.floor((minutes % 1440) / 60);
  if (days > 0) return `${days}d ${hours}h`;
  if (hours > 0) return `${hours}h ${minutes % 60}m`;
  return `${minutes}m`;
}

export function formatKind(proposal) {
  const target = proposal.targetVersion === null ? 'new item' : `v${proposal.targetVersion}`;
  return `${proposal.operation} ${target}${proposal.isPinned ? ' (pinned)' : ''}`;
}

// Proposal text can come from untrusted content, so a control character prints escaped: an escape
// sequence must not redraw the text the confirmation shows. Newlines stay.
export function escapeControls(value) {
  return String(value).replace(
    /[\u0000-\u0009\u000b-\u001f\u007f-\u009f]/g,
    (char) => `\\x${char.charCodeAt(0).toString(16).padStart(2, '0')}`,
  );
}

// a labelled block of text, each line after the first indented under the first
const formatBlock = (label, value, style = (line) => line) =>
  escapeControls(value)
    .split('\n')
    .map((line, index) => `  ${index === 0 ? label.padEnd(7) : '       '} ${style(line)}`);

export function formatProposal(proposal, now = Date.now()) {
  const lapsesIn = formatAge(new Date(now).toISOString(), Date.parse(proposal.lapseAt));
  return [
    `${bold(escapeControls(proposal.proposalID))}`,
    `  kind    ${escapeControls(formatKind(proposal))}`,
    `  reason  ${escapeControls(proposal.reason)}`,
    `  age     ${formatAge(proposal.createdAt, now)} ${dim(`(lapses in ${lapsesIn})`)}`,
    `  source  ${escapeControls(`${proposal.origin}, ${proposal.source}`)}`,
    ...formatBlock('text', proposal.text),
    ...(proposal.quote === null ? [] : formatBlock('quote', proposal.quote, dim)),
  ].join('\n');
}

// An ID, or with a confirmation a unique prefix of at least 8 characters. --yes takes the full ID,
// because a prefix could match a proposal that arrived after the listing the user read.
export function findProposal(pending, id, { exact = false } = {}) {
  if (exact ? id.length < 36 : id.length < 8) {
    fail(exact ? '--yes takes the full proposal ID' : 'give at least 8 characters of the proposal ID');
  }
  const matches = pending.filter((proposal) =>
    exact ? proposal.proposalID === id : proposal.proposalID.startsWith(id),
  );
  if (matches.length === 0) {
    fail(`no pending memory proposal ${id}; run nixie memory pending`);
  }
  if (matches.length > 1) {
    fail(`${id} matches ${matches.length} pending proposals; give more of the ID`);
  }
  return matches[0];
}

async function memoryPending(config) {
  const pending = await runMemoryCommand(config, 'memory-pending');
  if (pending.length === 0) {
    console.log(dim('no memory proposal waits for an answer'));
    return 0;
  }
  console.log(pending.map((proposal) => formatProposal(proposal)).join('\n\n'));
  console.log(dim(`\n${pending.length} pending; answer with nixie memory approve|reject <id>`));
  return 0;
}

// -y/--yes, --text <text> and, for a proposal's answer, --reason <why> (or --text=, --reason=)
// anywhere; every other argument is positional
export function parseMemoryArgs(args, { takesReason = false } = {}) {
  const parsed = { yes: false, text: undefined, reason: undefined, positionals: [] };
  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === '-y' || arg === '--yes') {
      parsed.yes = true;
    } else if (arg === '--text') {
      if (index + 1 >= args.length) {
        fail('--text takes the text');
      }
      parsed.text = args[(index += 1)];
    } else if (arg.startsWith('--text=')) {
      parsed.text = arg.slice('--text='.length);
    } else if (takesReason && arg === '--reason') {
      // an option after --reason is a missing reason; --reason=<why> takes one that starts with -
      if (index + 1 >= args.length || args[index + 1].startsWith('-')) {
        fail('--reason takes the reason');
      }
      parsed.reason = args[(index += 1)];
    } else if (takesReason && arg.startsWith('--reason=')) {
      parsed.reason = arg.slice('--reason='.length);
    } else if (arg.startsWith('-') && arg !== '-') {
      fail(`unknown option ${arg}`);
    } else {
      parsed.positionals.push(arg);
    }
  }
  if (parsed.text !== undefined && parsed.text.trim() === '') {
    fail('--text takes the text, and blank text replaces nothing');
  }
  if (parsed.reason !== undefined && parsed.reason.trim() === '') {
    fail('--reason takes the reason; leave it out to give none');
  }
  return parsed;
}

// asks on the terminal unless --yes; nothing changes without a yes
function confirm(question, what, yes) {
  if (yes) {
    return;
  }
  if (!process.stdin.isTTY) {
    fail(`${what}: needs a terminal to confirm, or --yes; nothing changed`);
  }
  const reply = prompt(`\n${question} [y/N]`);
  if (!['y', 'yes'].includes(reply?.trim().toLowerCase())) {
    fail(`${what}: not confirmed; nothing changed`);
  }
}

async function memoryAnswer(config, answer, args) {
  return answerProposal(answer, args, { run: (...command) => runMemoryCommand(config, ...command) });
}

// The answer binds to the action hash of the proposal shown here, so a proposal that changed since
// this listing refuses it and nothing applies. --text approves the proposal with your own text;
// --reason tells nixie why you reject it, and the conversation reads it in its next turn.
export async function answerProposal(answer, args, { run, log = console.log }) {
  const { yes, text, reason, positionals } = parseMemoryArgs(args, { takesReason: true });
  const misplaced = answer === 'reject' ? text : reason;
  if (positionals.length !== 1 || misplaced !== undefined) {
    fail(
      answer === 'approve'
        ? 'usage: nixie memory approve <id> [--text <edited text>] [--yes]'
        : 'usage: nixie memory reject <id> [--reason <why>] [--yes]',
    );
  }

  const pending = await run('memory-pending');
  const proposal = findProposal(pending, positionals[0], { exact: yes });
  log(formatProposal(proposal));
  if (text !== undefined) {
    log(formatBlock('yours', text, bold).join('\n'));
  }
  if (reason !== undefined) {
    log(formatBlock('why', reason, bold).join('\n'));
  }
  const question = text === undefined ? `${answer} this proposal?` : 'approve it with your text?';
  confirm(question, `memory ${answer}`, yes);

  const result = await run(
    `memory-${answer}`,
    proposal.proposalID,
    '--hash',
    proposal.actionHash,
    ...(text === undefined ? [] : [`--text=${text}`]),
    ...(reason === undefined ? [] : [`--reason=${reason}`]),
  );
  log(`${green('✓')} ${formatAnswerOutcome(answer, result)}`);
  return 0;
}

// an approval the server holds for a close match applies nothing; it prints the match instead
export function formatAnswerOutcome(answer, result) {
  if (answer === 'reject') {
    return 'rejected';
  }
  if (result.status === 'close_match') {
    return `held: it closely matches ${result.item.itemID} v${result.item.version}`;
  }
  return `approved as ${result.itemID} v${result.version}`;
}

// What `memory show` prints: the item's state, then each version oldest first. A version whose key
// is gone prints its status instead of its text.
export function formatItem(item) {
  const versions = item.versions.flatMap((version) => [
    `  ${bold(`v${version.version}`)} ${escapeControls(`${version.change}, ${version.state}`)} ${dim(
      escapeControls(`by ${version.origin}, ${version.source}, ${version.recordedAt}`),
    )}`,
    ...(version.status === 'readable'
      ? formatBlock('', version.text).map((line) => `  ${line}`)
      : [`    ${dim(`(${escapeControls(version.status)})`)}`]),
  ]);
  return [`${bold(escapeControls(item.itemID))} ${escapeControls(item.state)}`, ...versions].join('\n');
}

// <itemID> or <itemID>@<version>; an item ID is the full ID that `memory show` prints. show, pin
// and unpin act on the item and not a version, so they take no version.
export function parseItemTarget(target, { takesVersion = true } = {}) {
  const match = /^([0-9a-f-]{36})(?:@([1-9]\d*))?$/.exec(target ?? '');
  if (!match) {
    fail(takesVersion ? 'give the full item ID, or <item ID>@<version>' : 'give the full item ID');
  }
  if (!takesVersion && match[2] !== undefined) {
    fail('this command acts on the item, not a version: give the item ID alone');
  }
  return { itemID: match[1], version: match[2] === undefined ? undefined : Number(match[2]) };
}

async function memoryShow(config, args) {
  const { positionals } = parseMemoryArgs(args);
  if (positionals.length !== 1) {
    fail('usage: nixie memory show <item ID>');
  }
  const { itemID } = parseItemTarget(positionals[0], { takesVersion: false });
  console.log(formatItem(await runMemoryCommand(config, 'memory-show', itemID)));
  return 0;
}

// An edit, a retirement or a restore binds to a version: the one named as <itemID>@<version>, or
// else the current one shown here, so a change that lands in between refuses it and nothing applies.
async function memoryChange(config, change, args) {
  const { yes, text, positionals } = parseMemoryArgs(args);
  const usage =
    change === 'edit'
      ? 'usage: nixie memory edit <item ID>[@<version>] --text <new text> [--yes]'
      : `usage: nixie memory ${change} <item ID>[@<version>] [--yes]`;
  if (positionals.length !== 1 || (change === 'edit') !== (text !== undefined)) {
    fail(usage);
  }

  const target = parseItemTarget(positionals[0]);
  const item = await runMemoryCommand(config, 'memory-show', target.itemID);
  const current = item.versions.at(-1);
  const version = target.version ?? current.version;
  console.log(formatItem(item));
  if (text !== undefined) {
    console.log(`\n${formatBlock('new', text, bold).join('\n')}`);
  }
  confirm(`${change} v${version} of this item?`, `memory ${change}`, yes);

  const result = await runMemoryCommand(
    config,
    `memory-${change}`,
    `${target.itemID}@${version}`,
    ...(text === undefined ? [] : [`--text=${text}`]),
  );
  console.log(`${green('✓')} ${change === 'edit' ? 'edited' : `${change}d`}: now v${result.version}`);
  return 0;
}

// A pin adds no version and can be undone at once, so it asks nothing.
async function memoryPin(config, isPinned, args) {
  const { positionals } = parseMemoryArgs(args);
  if (positionals.length !== 1) {
    fail(`usage: nixie memory ${isPinned ? 'pin' : 'unpin'} <item ID>`);
  }
  const { itemID } = parseItemTarget(positionals[0], { takesVersion: false });
  await runMemoryCommand(config, `memory-${isPinned ? 'pin' : 'unpin'}`, itemID);
  console.log(`${green('✓')} ${isPinned ? 'pinned' : 'unpinned'} ${itemID}`);
  return 0;
}

// -------------------------------------------------------------------------------- memory review

// One key scheme for every review loop. A key press answers the entry shown, so it asks nothing more.
export const reviewKeys = { a: 'approve', r: 'reject', e: 'edit', s: 'skip', q: 'quit' };
const reviewQuestion = '[a]pprove  [r]eject  [e]dit and approve  [s]kip  [q]uit';

// Shows each entry and reads one key until the key is in reviewKeys. answer(action, entry) does
// the work and returns the outcome to count, or 'again' to ask about the same entry once more. A
// Failure in one answer prints as refused and the loop goes on to the next entry.
export async function reviewLoop(entries, { show, answer, readKey, log = console.log }) {
  const counts = { approved: 0, edited: 0, rejected: 0, skipped: 0, refused: 0, held: 0, unanswered: 0 };
  for (const [index, entry] of entries.entries()) {
    log(`\n${dim(`${index + 1}/${entries.length}`)} ${show(entry)}`);
    let outcome = 'again';
    while (outcome === 'again') {
      const action = reviewKeys[await readKey(reviewQuestion)];
      if (action === undefined) {
        log(dim('press a, r, e, s or q'));
        continue;
      }
      if (action === 'quit') {
        counts.unanswered = entries.length - index;
        return counts;
      }
      try {
        outcome = await answer(action, entry);
      } catch (error) {
        if (!(error instanceof Failure)) {
          throw error;
        }
        log(`${red('✗')} refused: ${error.message}`);
        outcome = 'refused';
      }
    }
    counts[outcome] += 1;
  }
  return counts;
}

export function formatReviewSummary(counts) {
  const parts = ['approved', 'edited', 'rejected', 'skipped'].map((name) => `${name} ${counts[name]}`);
  for (const name of ['refused', 'held']) {
    if (counts[name] > 0) parts.push(`${name} ${counts[name]}`);
  }
  const left = counts.unanswered > 0 ? `; quit with ${counts.unanswered} unanswered` : '';
  return `${parts.join(', ')}${left}`;
}

// Each answer binds to the action hash of the proposal shown, as `approve` and `reject` do, so a
// proposal that changed since the listing refuses it and the loop moves on. An edit that leaves
// the text as it was approves the proposal as it is; a blank edit or a failed editor sends nothing.
export async function reviewProposals(pending, { run, readKey, editText, log = console.log }) {
  const send = async (proposal, text) => {
    const result = await run(
      'memory-approve',
      proposal.proposalID,
      '--hash',
      proposal.actionHash,
      ...(text === undefined ? [] : [`--text=${text}`]),
    );
    const isHeld = result.status === 'close_match';
    log(`${isHeld ? yellow('!') : green('✓')} ${formatAnswerOutcome('approve', result)}`);
    return isHeld ? 'held' : text === undefined ? 'approved' : 'edited';
  };

  const answer = async (action, proposal) => {
    if (action === 'skip') {
      log(dim('skipped'));
      return 'skipped';
    }
    if (action === 'reject') {
      await run('memory-reject', proposal.proposalID, '--hash', proposal.actionHash);
      log(`${green('✓')} rejected`);
      return 'rejected';
    }
    if (action === 'approve') {
      return send(proposal);
    }
    const text = await editText(proposal.text);
    if (text === undefined || text.trim() === '') {
      log(yellow('edit cancelled: the editor failed or saved blank text; nothing sent'));
      return 'again';
    }
    if (text === proposal.text.trimEnd()) {
      return send(proposal);
    }
    log(formatBlock('yours', text, bold).join('\n'));
    return send(proposal, text);
  };

  return reviewLoop(pending, { show: (proposal) => formatProposal(proposal), answer, readKey, log });
}

// Opens the text in the editor, as git does: $EDITOR may carry its own arguments. Returns the
// saved text without trailing whitespace, or undefined when the editor exits non-zero. The file
// sits in a private temporary folder and goes away after.
export async function editInEditor(text, editor = process.env.EDITOR || 'vi') {
  const folder = mkdtempSync(join(tmpdir(), 'nixie-review-'));
  const file = join(folder, 'proposal.txt');
  try {
    writeFileSync(file, `${text}\n`, { mode: 0o600 });
    const proc = Bun.spawn(['sh', '-c', `${editor} "$1"`, 'sh', file], {
      stdio: ['inherit', 'inherit', 'inherit'],
    });
    if ((await proc.exited) !== 0) {
      return undefined;
    }
    return readFileSync(file, 'utf8').trimEnd();
  } finally {
    rmSync(folder, { recursive: true, force: true });
  }
}

// One key press, without Enter. Ctrl-C, Ctrl-D and Escape quit, because raw mode turns off the
// signal that Ctrl-C sends.
async function readTerminalKey(question) {
  process.stdin.setRawMode(true);
  process.stdin.resume();
  process.stdout.write(`${question} `);
  const chunk = await new Promise((resolve) => process.stdin.once('data', resolve));
  process.stdin.setRawMode(false);
  process.stdin.pause();
  const key = chunk.toString('utf8');
  process.stdout.write(`${/^[ -~]$/.test(key) ? key : ''}\n`);
  return ['\x03', '\x04', '\x1b'].includes(key) ? 'q' : key.toLowerCase();
}

// Reviews everything that waits for an answer in one loop and one key scheme: the pending proposals
// first, then the changes of the weekly memory diff. A quit during the proposals leaves the diff
// unanswered too.
async function memoryReview(config, args) {
  if (args.length > 0) {
    fail(`memory review: unknown argument ${args[0]}\n${memoryUsage}`);
  }
  if (!process.stdin.isTTY) {
    fail('memory review: needs a terminal to read keys; use nixie memory approve|reject <id> --yes');
  }
  const pending = await runMemoryCommand(config, 'memory-pending');
  const diff = await runMemoryCommand(config, 'memory-diff');
  const changes = diff?.changes ?? [];
  if (pending.length === 0 && changes.length === 0) {
    console.log(dim('no memory proposal or diff change waits for an answer'));
    return 0;
  }
  const run = (...args) => runMemoryCommand(config, ...args);
  const counts = await reviewEverything(pending, changes, {
    run,
    readKey: readTerminalKey,
    editText: (text) => editInEditor(text),
  });
  console.log(`\n${formatReviewSummary(counts)}`);
  return counts.refused > 0 ? 1 : 0;
}

// The proposals, then the diff's changes, each under its heading, with the counts of both added.
export async function reviewEverything(pending, changes, { run, readKey, editText, log = console.log }) {
  let proposals = null;
  if (pending.length > 0) {
    log(bold(`memory proposals · ${pending.length} pending`));
    proposals = await reviewProposals(pending, { run, readKey, editText, log });
    if (proposals.unanswered > 0) {
      return { ...proposals, unanswered: proposals.unanswered + changes.length };
    }
  }
  if (changes.length === 0) {
    return proposals;
  }
  log(`${proposals === null ? '' : '\n'}${bold(`memory diff · ${changes.length} pending`)}`);
  return addCounts(proposals, await reviewDiffChanges(changes, { run, readKey, log }));
}

function addCounts(first, second) {
  if (first === null || second === null) {
    return first ?? second;
  }
  return Object.fromEntries(Object.keys(first).map((name) => [name, first[name] + second[name]]));
}

// Each answer binds to the action hash of the change shown and is its own approval, so a change
// that moved on applies nothing, prints why, and the loop goes on. A change from the diff takes no
// edit: e says so and asks again.
export async function reviewDiffChanges(changes, { run, readKey, log = console.log }) {
  const answer = async (action, change) => {
    if (action === 'skip') {
      log(dim('skipped'));
      return 'skipped';
    }
    if (action === 'edit') {
      log(yellow('a change from the diff takes no edit; approve, reject or skip it'));
      return 'again';
    }
    if (action === 'reject') {
      await run('memory-diff-reject', change.changeID, '--hash', change.actionHash);
      log(`${green('✓')} rejected; nothing changed in memory`);
      return 'rejected';
    }
    const result = await run('memory-diff-approve', `${change.changeID}=${change.actionHash}`);
    const [outcome] = result.outcomes;
    log(formatChangeOutcome(outcome));
    return outcome.status === 'applied' ? 'approved' : 'refused';
  };

  return reviewLoop(changes, { show: (change) => formatChange(change, null), answer, readKey, log });
}

// ---------------------------------------------------------------------------------- memory diff

// What `memory diff` prints of one change: its number, when given, and its kind, each item it read with that
// version's text, the text it writes, and why. An item that moved on since prints as stale, and an
// approval of its change fails.
export function formatChange(change, index, now = Date.now()) {
  const lapsesIn = formatAge(new Date(now).toISOString(), Date.parse(change.lapseAt));
  const label = { merge: 'merge', rewrite: 'from', retire: 'retire' }[change.kind] ?? 'item';
  const inputs = change.inputs.flatMap((input) => {
    const [first, ...more] = formatBlock(label, input.text ?? '(unreadable)');
    const ref = dim(escapeControls(`${input.itemID}@${input.version}`));
    const stale = input.isCurrent ? '' : ` ${yellow('(stale: the item moved on)')}`;
    return [`${first}  ${ref}${stale}`, ...more];
  });
  const into = change.kind === 'merge' ? 'into' : 'to';
  return [
    `${bold(`${index === null ? '' : `${index + 1}. `}${escapeControls(change.kind)}`)} ${dim(escapeControls(change.changeID))}`,
    ...inputs,
    ...(change.text === null ? [] : formatBlock(into, change.text, bold)),
    ...formatBlock('why', change.reason, dim),
    `  source  ${escapeControls(change.source)} ${dim(`(lapses in ${lapsesIn})`)}`,
  ].join('\n');
}

export function formatDiff(diff, now = Date.now()) {
  const heading = `${bold('memory diff')} ${dim(
    escapeControls(`${diff.diffID}, proposed ${diff.createdAt} by ${diff.model ?? 'no model'}`),
  )}`;
  return [heading, ...diff.changes.map((change, index) => formatChange(change, index, now))].join('\n\n');
}

// A change ID, or with a confirmation a unique prefix of at least 8 characters; --yes takes the
// full ID, as for a proposal.
export function findChange(diff, id, { exact = false } = {}) {
  if (exact ? id.length < 36 : id.length < 8) {
    fail(exact ? '--yes takes the full change ID' : 'give at least 8 characters of the change ID');
  }
  const matches = diff.changes.filter((change) =>
    exact ? change.changeID === id : change.changeID.startsWith(id),
  );
  if (matches.length === 0) {
    fail(`no pending change ${id} in the memory diff; run nixie memory diff`);
  }
  if (matches.length > 1) {
    fail(`${id} matches ${matches.length} pending changes; give more of the ID`);
  }
  return matches[0];
}

// What an approval did to each change: the versions it wrote, or the reason it applied nothing.
export function formatChangeOutcome(outcome) {
  if (outcome.status === 'applied') {
    const versions = outcome.versions.map((version) => `${version.itemID} v${version.version}`);
    return `${green('✓')} ${escapeControls(outcome.changeID)}: ${escapeControls(versions.join(', '))}`;
  }
  const reasons = {
    STALE_VERSION: 'an item moved on since the diff read it',
    WRONG_STATE: 'an item is no longer active',
    NOT_FOUND: 'an item or the change is gone',
    PROPOSAL_CLOSED: 'the change was already answered or lapsed',
    PROPOSAL_HASH: 'the change differs from the one shown',
    PINNED_CORE_FULL: 'the pinned core has no room for the new text',
  };
  return `${red('✗')} ${escapeControls(outcome.changeID)}: ${reasons[outcome.code] ?? escapeControls(outcome.code)}; nothing applied`;
}

async function readDiff(config) {
  const diff = await runMemoryCommand(config, 'memory-diff');
  if (diff === null || diff.changes.length === 0) {
    console.log(dim('no memory diff waits for an answer'));
    return null;
  }
  return diff;
}

// With no ID, an approval covers the whole diff shown; with IDs, only those changes. Each change
// binds to the action hash shown here and is its own approval, so a change that moved on applies
// nothing while the rest go on.
async function memoryDiff(config, args) {
  const [action, ...rest] = args;
  const { yes, text, positionals } = parseMemoryArgs(rest);
  if (text !== undefined || !['show', 'approve', 'reject'].includes(action ?? 'show')) {
    fail(memoryUsage);
  }
  const diff = await readDiff(config);
  if (diff === null) {
    return action === undefined || action === 'show' ? 0 : 1;
  }
  if (action === undefined || action === 'show') {
    console.log(formatDiff(diff));
    console.log(dim(`\n${diff.changes.length} pending; answer with nixie memory review, or nixie memory diff approve|reject`));
    return 0;
  }
  return action === 'approve'
    ? memoryDiffApprove(config, diff, positionals, yes)
    : memoryDiffReject(config, diff, positionals, yes);
}

async function memoryDiffApprove(config, diff, ids, yes) {
  const changes = ids.length === 0 ? diff.changes : ids.map((id) => findChange(diff, id, { exact: yes }));
  if (new Set(changes).size !== changes.length) {
    fail('memory diff approve: a change is named twice');
  }
  console.log(
    changes.map((change) => formatChange(change, diff.changes.indexOf(change))).join('\n\n'),
  );
  const question =
    ids.length === 0
      ? `approve the whole diff, all ${changes.length} changes?`
      : `approve ${changes.length === 1 ? 'this change' : `these ${changes.length} changes`}?`;
  confirm(question, 'memory diff approve', yes);

  const result = await runMemoryCommand(
    config,
    'memory-diff-approve',
    ...changes.map((change) => `${change.changeID}=${change.actionHash}`),
  );
  console.log(result.outcomes.map((outcome) => formatChangeOutcome(outcome)).join('\n'));
  return result.outcomes.every((outcome) => outcome.status === 'applied') ? 0 : 1;
}

async function memoryDiffReject(config, diff, ids, yes) {
  if (ids.length !== 1) {
    fail('usage: nixie memory diff reject <change id> [--yes]');
  }
  const change = findChange(diff, ids[0], { exact: yes });
  console.log(formatChange(change, diff.changes.indexOf(change)));
  confirm('reject this change?', 'memory diff reject', yes);

  await runMemoryCommand(config, 'memory-diff-reject', change.changeID, '--hash', change.actionHash);
  console.log(`${green('✓')} rejected; nothing changed in memory`);
  return 0;
}

const memoryUsage = [
  'usage: nixie memory pending | review | approve <id> [--text <edited text>] [--yes] | reject <id> [--reason <why>] [--yes]',
  '       nixie memory show <item ID> | edit <item ID>[@<version>] --text <new text> [--yes]',
  '       nixie memory retire|restore <item ID>[@<version>] [--yes] | pin|unpin <item ID>',
  '       nixie memory diff [show] | diff approve [<change id>...] [--yes] | diff reject <change id> [--yes]',
].join('\n');

async function memory(args) {
  const [sub, ...rest] = args;
  if (sub === 'pending') {
    if (rest.length > 0) {
      fail(`memory pending: unknown argument ${rest[0]}\n${memoryUsage}`);
    }
    return memoryPending(loadConfig());
  }
  if (sub === 'review') {
    return memoryReview(loadConfig(), rest);
  }
  if (sub === 'approve' || sub === 'reject') {
    return memoryAnswer(loadConfig(), sub, rest);
  }
  if (sub === 'show') {
    return memoryShow(loadConfig(), rest);
  }
  if (sub === 'edit' || sub === 'retire' || sub === 'restore') {
    return memoryChange(loadConfig(), sub, rest);
  }
  if (sub === 'pin' || sub === 'unpin') {
    return memoryPin(loadConfig(), sub === 'pin', rest);
  }
  if (['-h', '--help', 'help'].includes(sub)) {
    console.log(memoryUsage);
    return 0;
  }
  if (sub === 'diff') {
    return memoryDiff(loadConfig(), rest);
  }
  fail(sub === undefined ? memoryUsage : `memory: unknown subcommand ${sub}\n${memoryUsage}`);
}

// ---------------------------------------------------------------------------------------- skill

// The pod's skill-* host commands list Nix's skill proposals and answer each one. An approval puts
// the skill in force in nixie at once, and nixie exports it to the definitions repo itself.

// Shows a diff of each file against the version of the skill in force: a file only the proposal
// has diffs against nothing, and a file only the version in force has shows as removed.
export function formatSkillDiffs(proposal) {
  const proposed = new Map(proposal.files.map((file) => [file.path, file.text]));
  const inForce = new Map((proposal.inForce?.files ?? []).map((file) => [file.path, file.text]));
  const paths = [...new Set([...inForce.keys(), ...proposed.keys()])].sort();
  return paths.map((path) => formatFileDiff(path, inForce.get(path), proposed.get(path))).join('\n');
}

// diff -u between the two texts, through 2 private temporary files; an absent side diffs as
// /dev/null. The text can come from untrusted content, so control characters print escaped.
function formatFileDiff(path, before, after) {
  // diff finds no line to show for an empty file on one side only, so its add or removal says so
  if (before === undefined && after === '') {
    return `    ${green(`+ new empty file b/${escapeControls(path)}`)}`;
  }
  if (after === undefined && before === '') {
    return `    ${red(`- removed empty file a/${escapeControls(path)}`)}`;
  }
  const folder = mkdtempSync(join(tmpdir(), 'nixie-skill-diff-'));
  try {
    const beforeFile = join(folder, 'before');
    const afterFile = join(folder, 'after');
    writeFileSync(beforeFile, before ?? '', { mode: 0o600 });
    writeFileSync(afterFile, after ?? '', { mode: 0o600 });
    const labels = [before === undefined ? '/dev/null' : `a/${path}`, after === undefined ? '/dev/null' : `b/${path}`];
    const proc = Bun.spawnSync(['diff', '-u', '--label', labels[0], '--label', labels[1], beforeFile, afterFile]);
    if (proc.exitCode === 0) {
      return dim(`  ${escapeControls(path)}: unchanged`);
    }
    if (proc.exitCode !== 1) {
      fail(`diff failed on ${path}: ${proc.stderr.toString().trim()}`);
    }
    return escapeControls(proc.stdout.toString())
      .trimEnd()
      .split('\n')
      .map((line) => (line.startsWith('+') ? green(line) : line.startsWith('-') ? red(line) : line))
      .map((line) => `    ${line}`)
      .join('\n');
  } finally {
    rmSync(folder, { recursive: true, force: true });
  }
}

// the token check's result: a destination-like token in the files that you never typed and your
// definitions lack is the thing to read before an approval
export function formatTokenCheck(proposal) {
  if (proposal.untypedToken === null) {
    return `  token   ${green('passed')} ${dim('(each destination-like token traces to your words or definitions)')}`;
  }
  const { kind, raw } = proposal.untypedToken;
  return `  token   ${red(`untyped ${escapeControls(kind)}: ${escapeControls(raw)}`)} ${dim('(you never typed it, and your definitions lack it)')}`;
}

const skillOriginNotes = {
  vendored: '(vendored: an approval replaces the copy skills.lock.json pins)',
  nixie: '(nixie wrote it; its export may not have merged yet)',
};

function formatSkillTarget(proposal) {
  if (proposal.inForce === null) {
    return 'new skill';
  }
  const replaced = `replaces ${proposal.inForce.skillHash.slice(0, 12)}`;
  const note = skillOriginNotes[proposal.inForce.origin];
  return note === undefined ? replaced : `${replaced} ${yellow(note)}`;
}

export function formatSkillProposal(proposal, now = Date.now()) {
  const lapsesIn = formatAge(new Date(now).toISOString(), Date.parse(proposal.lapseAt));
  return [
    `${bold(escapeControls(proposal.proposalID))} ${escapeControls(proposal.name)}`,
    `  skill   ${formatSkillTarget(proposal)}`,
    ...(proposal.isStale
      ? [`  stale   ${yellow('the skill in force moved past the version this replaces; an answer is refused, and it lapses')}`]
      : []),
    `  age     ${formatAge(proposal.createdAt, now)} ${dim(`(lapses in ${lapsesIn})`)}`,
    `  from    ${escapeControls(`${proposal.thread ?? 'no thread'}, run ${proposal.provenance.runID}`)}`,
    formatTokenCheck(proposal),
    formatSkillDiffs(proposal),
  ].join('\n');
}

// A skill proposal's ID is the 10-character short ID that skill-pending prints, given in full.
export function findSkillProposal(pending, id) {
  const proposal = pending.find((candidate) => candidate.proposalID === id);
  if (proposal === undefined) {
    fail(`no pending skill proposal ${id}; run nixie skill pending`);
  }
  return proposal;
}

// -y/--yes, --reason <why> and --keep <side> (or --reason=, --keep=) anywhere; every other
// argument is positional
export function parseSkillArgs(args) {
  const parsed = { yes: false, reason: undefined, keep: undefined, positionals: [] };
  const valued = { '--reason': 'reason', '--keep': 'keep' };
  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    const [flag, inline] = arg.startsWith('--') && arg.includes('=') ? [arg.slice(0, arg.indexOf('=')), arg.slice(arg.indexOf('=') + 1)] : [arg, undefined];
    if (arg === '-y' || arg === '--yes') {
      parsed.yes = true;
    } else if (valued[flag] !== undefined) {
      const value = inline ?? args[index + 1];
      if (value === undefined || (inline === undefined && value.startsWith('-')) || value.trim() === '') {
        fail(`${flag} takes ${flag === '--reason' ? 'the reason' : 'nixie or definitions'}`);
      }
      parsed[valued[flag]] = value;
      index += inline === undefined ? 1 : 0;
    } else if (arg.startsWith('-') && arg !== '-') {
      fail(`unknown option ${arg}`);
    } else {
      parsed.positionals.push(arg);
    }
  }
  return parsed;
}

// a proposed path stays inside the folder the editor reads; the server checked it, and this
// checks again before anything writes to disk
function resolveSkillPath(folder, path) {
  const target = normalize(join(folder, path));
  if (!target.startsWith(`${folder}/`)) {
    fail(`the proposal's file ${path} leaves the skill's folder; nothing written`);
  }
  return target;
}

// Writes the proposal's files to a private temporary folder, opens them all in the editor, as git
// does ($EDITOR may carry its own arguments), and reads them back. Returns the edited files, or
// undefined when the editor exits non-zero. The folder goes away after.
export async function editSkillFiles(proposal, editor = process.env.EDITOR || 'vi') {
  const folder = mkdtempSync(join(tmpdir(), 'nixie-skill-edit-'));
  try {
    const written = proposal.files.map((file) => {
      const target = resolveSkillPath(folder, file.path);
      mkdirSync(dirname(target), { recursive: true });
      writeFileSync(target, file.text, { mode: 0o600 });
      return { path: file.path, target };
    });
    const proc = Bun.spawn(['sh', '-c', `${editor} "$@"`, 'sh', ...written.map((file) => file.target)], {
      stdio: ['inherit', 'inherit', 'inherit'],
    });
    if ((await proc.exited) !== 0) {
      return undefined;
    }
    return written.map((file) => ({ path: file.path, text: readFileSync(file.target, 'utf8') }));
  } finally {
    rmSync(folder, { recursive: true, force: true });
  }
}

// the most the edited files take as one argument of the remote command line
const maxEditedBytes = 100_000;

// Approves the proposal under the skill hash it was shown with, with your edited files when you
// changed any, and prints the approval. The skill is in force for the next task.
async function approveSkill(run, proposal, files, log) {
  const isEdited = files !== undefined && files.some((file, index) => file.text !== proposal.files[index].text);
  const encoded = isEdited ? JSON.stringify(files) : undefined;
  if (encoded !== undefined && Buffer.byteLength(encoded) > maxEditedBytes) {
    fail(`the edited files take more than ${maxEditedBytes} bytes; approve them unedited, or ask Nix for a new proposal`);
  }
  const result = await run(
    'skill-approve',
    proposal.proposalID,
    '--hash',
    proposal.skillHash,
    ...(encoded === undefined ? [] : [`--files=${encoded}`]),
  );
  log(`${green('✓')} approved${isEdited ? ' with your edits' : ''}: in force for new tasks (approval ${result.approvalID})`);
  return isEdited ? 'edited' : 'approved';
}

// Each answer binds to the skill hash of the proposal shown, so a proposal that closed or went
// stale since the listing refuses it and the loop goes on. An edit and approve opens the files in
// the editor first; a failed editor sends nothing. A rejection asks for its reason, which Nix reads
// on its next turn, and a blank reason sends nothing.
export async function reviewSkillProposals(pending, { run, readKey, readReason, editFiles, log = console.log }) {
  const answer = async (action, proposal) => {
    if (action === 'skip') {
      log(dim('skipped'));
      return 'skipped';
    }
    if (action === 'reject') {
      const reason = (await readReason())?.trim();
      if (!reason) {
        log(yellow('a rejection takes a reason, which Nix reads; nothing sent'));
        return 'again';
      }
      await run('skill-reject', proposal.proposalID, '--hash', proposal.skillHash, `--reason=${reason}`);
      log(`${green('✓')} rejected`);
      return 'rejected';
    }
    if (action === 'approve') {
      return approveSkill(run, proposal, undefined, log);
    }
    const files = await editFiles(proposal);
    if (files === undefined) {
      log(yellow('edit cancelled: the editor failed; nothing sent'));
      return 'again';
    }
    return approveSkill(run, proposal, files, log);
  };

  return reviewLoop(pending, { show: (proposal) => formatSkillProposal(proposal), answer, readKey, log });
}

// `skill approve <id>` puts the skill in force; `skill reject <id> --reason <why>` records the
// rejection. Each asks first unless --yes.
export async function answerSkillProposal(answer, args, { run, log = console.log, ask = confirm }) {
  const { yes, reason, keep, positionals } = parseSkillArgs(args);
  const misplaced = keep ?? (answer === 'approve' ? reason : undefined);
  if (positionals.length !== 1 || misplaced !== undefined || (answer === 'reject' && reason === undefined)) {
    fail(answer === 'approve' ? 'usage: nixie skill approve <id> [--yes]' : 'usage: nixie skill reject <id> --reason <why> [--yes]');
  }
  const proposal = findSkillProposal(await run('skill-pending'), positionals[0]);
  log(formatSkillProposal(proposal));
  if (answer === 'reject') {
    log(formatBlock('why', reason, bold).join('\n'));
    ask('reject this proposal?', 'skill reject', yes);
    await run('skill-reject', proposal.proposalID, '--hash', proposal.skillHash, `--reason=${reason}`);
    log(`${green('✓')} rejected`);
    return 0;
  }
  ask('approve it? it goes in force for new tasks', 'skill approve', yes);
  await approveSkill(run, proposal, undefined, log);
  return 0;
}

// One skill that nixie wrote and that is in force: the approval that applied it, the pull request
// that exports it to your definitions repo, and a conflict when your definitions changed the skill
// after the approval.
export function formatWrittenSkill(skill, now = Date.now()) {
  const lines = [
    `${bold(escapeControls(skill.name))} ${dim(`approval ${skill.approvalID}`)}`,
    `  from    proposal ${escapeControls(skill.proposalID)}, approved ${formatAge(skill.approvedAt, now)} ago`,
    `  skill   ${skill.skillHash.slice(0, 12)} ${dim(skill.base === null ? '(new to your definitions)' : `(replaces ${skill.base.skillHash.slice(0, 12)})`)}`,
    `  export  ${skill.pullRequestURL == null ? dim('no pull request yet') : escapeControls(skill.pullRequestURL)}`,
  ];
  if (skill.isConflict) {
    const change = skill.definitions === null ? 'removed it' : `changed it to ${skill.definitions.skillHash.slice(0, 12)}`;
    lines.push(
      `  ${red('conflict')} your definitions ${change} after the approval`,
      dim(`  keep one: nixie skill resolve ${skill.approvalID} --keep nixie|definitions`),
    );
  }
  return lines.join('\n');
}

// `skill resolve <approval> --keep nixie|definitions`: nixie keeps its version over your change,
// or retires it and puts your definitions' version back in force. It asks first unless --yes.
export async function resolveWrittenSkill(args, { run, log = console.log, ask = confirm }) {
  const { yes, reason, keep, positionals } = parseSkillArgs(args);
  if (positionals.length !== 1 || reason !== undefined || !['nixie', 'definitions'].includes(keep)) {
    fail('usage: nixie skill resolve <approval> --keep nixie|definitions [--yes]');
  }
  const skill = (await run('skill-written')).find((candidate) => candidate.approvalID === positionals[0]);
  if (skill === undefined) {
    fail(`no skill nixie wrote is in force under approval ${positionals[0]}; run nixie skill written`);
  }
  log(formatWrittenSkill(skill));
  ask(keep === 'nixie' ? "keep nixie's version over your definitions?" : "retire nixie's version and keep your definitions'?", 'skill resolve', yes);
  await run('skill-resolve', skill.approvalID, `--keep=${keep}`);
  log(`${green('✓')} kept ${keep === 'nixie' ? "nixie's version" : "your definitions' version"}`);
  return 0;
}

const skillUsage = [
  'usage: nixie skill pending | review | written',
  '       nixie skill approve <id> [--yes]',
  '       nixie skill reject <id> --reason <why> [--yes]',
  '       nixie skill resolve <approval> --keep nixie|definitions [--yes]',
].join('\n');

async function skillPending(config) {
  const pending = await runMemoryCommand(config, 'skill-pending');
  if (pending.length === 0) {
    console.log(dim('no skill proposal waits for an answer'));
    return 0;
  }
  console.log(pending.map((proposal) => formatSkillProposal(proposal)).join('\n\n'));
  console.log(dim(`\n${pending.length} pending; answer with nixie skill review, or nixie skill approve|reject <id>`));
  return 0;
}

async function skillReview(config) {
  if (!process.stdin.isTTY) {
    fail('skill review: needs a terminal to read keys; use nixie skill approve|reject <id> --yes');
  }
  const pending = await runMemoryCommand(config, 'skill-pending');
  if (pending.length === 0) {
    console.log(dim('no skill proposal waits for an answer'));
    return 0;
  }
  console.log(bold(`skill proposals · ${pending.length} pending`));
  const counts = await reviewSkillProposals(pending, {
    run: (...args) => runMemoryCommand(config, ...args),
    readKey: readTerminalKey,
    readReason: async () => prompt('why (Nix reads this):'),
    editFiles: (proposal) => editSkillFiles(proposal),
  });
  console.log(`\n${formatReviewSummary(counts)}`);
  return counts.refused > 0 ? 1 : 0;
}

async function skillWritten(config) {
  const written = await runMemoryCommand(config, 'skill-written');
  if (written.length === 0) {
    console.log(dim('no skill nixie wrote is in force over your definitions'));
    return 0;
  }
  console.log(written.map((skill) => formatWrittenSkill(skill)).join('\n\n'));
  const conflicts = written.filter((skill) => skill.isConflict).length;
  console.log(dim(`\n${written.length} in force, ${conflicts} in conflict with your definitions`));
  return 0;
}

async function skill(args) {
  const [sub, ...rest] = args;
  if (['-h', '--help', 'help'].includes(sub)) {
    console.log(skillUsage);
    return 0;
  }
  if (['pending', 'review', 'written'].includes(sub) && rest.length > 0) {
    fail(`skill ${sub}: unknown argument ${rest[0]}\n${skillUsage}`);
  }
  if (sub === 'pending') {
    return skillPending(loadConfig());
  }
  if (sub === 'review') {
    return skillReview(loadConfig());
  }
  if (sub === 'written') {
    return skillWritten(loadConfig());
  }
  if (sub === 'approve' || sub === 'reject') {
    const config = loadConfig();
    return answerSkillProposal(sub, rest, { run: (...command) => runMemoryCommand(config, ...command) });
  }
  if (sub === 'resolve') {
    const config = loadConfig();
    return resolveWrittenSkill(rest, { run: (...command) => runMemoryCommand(config, ...command) });
  }
  fail(sub === undefined ? skillUsage : `skill: unknown subcommand ${sub}\n${skillUsage}`);
}

// ---------------------------------------------------------------------------------------- help

function help() {
  const width = Math.max(...Object.values(commands).map((command) => command.usage.length));
  console.log(`${bold('✿ nixie')} ${dim('· little helpers for the nixie deployment')}\n`);
  for (const command of Object.values(commands)) {
    console.log(`  nixie ${command.usage.padEnd(width)}  ${command.summary}`);
  }
  console.log(`\n${dim(`config: ${configPath}${existsSync(configPath) ? '' : ' (missing: run any command to see how to create it)'}`)}`);
  return 0;
}

const commands = {
  enrol: { usage: 'enrol', summary: 'mint an enrolment code and copy it to the clipboard', run: enrol },
  status: { usage: 'status', summary: 'show each readiness part', run: status },
  logs: { usage: 'logs [-f]', summary: "print nixie's pod log; -f follows it", run: logs },
  memory: {
    usage: 'memory <subcommand>',
    summary: 'review or answer memory proposals and the weekly memory diff; show, edit, retire, restore or pin an item',
    run: memory,
  },
  skill: {
    usage: 'skill <subcommand>',
    summary: "review or answer Nix's skill proposals; list the skills nixie wrote and resolve a conflict",
    run: skill,
  },
  reset: { usage: 'reset [--confirm]', summary: 'dry-run the factory reset; --confirm runs it', run: reset },
  help: { usage: 'help', summary: 'show this list', run: help },
};

async function main(argv) {
  const [name = 'help', ...args] = argv;
  const command = commands[name] ?? (['-h', '--help'].includes(name) ? commands.help : undefined);
  if (!command) {
    console.error(`nixie: unknown command ${name}\n`);
    help();
    return 2;
  }
  try {
    return await command.run(args);
  } catch (error) {
    if (error instanceof Failure) {
      console.error(`${red('nixie:')} ${error.message}`);
      return 1;
    }
    throw error;
  }
}

if (import.meta.main) {
  process.exitCode = await main(process.argv.slice(2));
}
