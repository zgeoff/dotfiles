#!/bin/sh
# chezmoi owns the keys below and deep-merges them over the live file. Every
# other key stays as Claude Code, a script or the machine's owner wrote it: the
# model, env.OP_SERVICE_ACCOUNT_TOKEN (rotated weekly by op-mint) and permissions.
# On a personal machine, chezmoi adds the op-mint allow rules, removes the GitHub
# token and key overrides from env, and owns autoMode in full: edit
# .chezmoitemplates/claude/automode.json.age with `chezmoi decrypt`/`chezmoi encrypt`,
# not the live file (an /auto-mode-setup run there is overwritten on the next apply).
# On any other machine, chezmoi keeps the env overrides, where a scoped GitHub
# token for agents lives, and removes the op-mint allow rules.
# Removing a key here does not remove it from the live file.
set -eu
current=$(cat)
[ -n "$current" ] || current='{}'
automode=null
{{- if and (hasKey . "personal") .personal }}
# A heredoc, not the quoted JSON below: the rules contain apostrophes.
automode=$(cat <<'AUTOMODE'
{{ joinPath .chezmoi.sourceDir ".chezmoitemplates/claude/automode.json.age" | include | decrypt | trim }}
AUTOMODE
)
{{- end }}
printf '%s' "$current" | jq --indent 2 --argjson automode "$automode" --argjson owned '
{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "FORCE_HYPERLINK": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "statusLine": {
    "type": "command",
    "command": "bash \"{{ .chezmoi.homeDir }}/.claude/statusline.sh\"",
    "padding": 2
  },
  "outputStyle": "STE Direct",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "autoCompactWindow": 500000,
  "tui": "fullscreen",
  "editorMode": "vim",
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "promptSuggestionEnabled": false,
  "advisorModel": "fable"
{{- if and (hasKey . "personal") .personal }},
  "enabledPlugins": {
    "codex-image@codex-image-in-cc": true
  },
  "extraKnownMarketplaces": {
    "codex-image-in-cc": {
      "source": { "source": "github", "repo": "KingGyuSuh/codex-image-in-cc" }
    }
  }
{{- end }}
}' '. * $owned
  | if $automode != null then .autoMode = $automode else . end
{{- if and (hasKey . "personal") .personal }}
  | .permissions.allow |= reduce (
      "Bash(op-mint --list)", "Bash(op-mint imp)", "Bash(op-mint nixie)",
      "Bash(op-mint noslop)", "Bash(op-mint osrs)", "Bash(op-mint pepys)", "Bash(op-mint vers)",
      "Bash(op-mint wow-forever)"
    ) as $rule (. // []; if any(.[]; . == $rule) then . else . + [$rule] end)
  # drop the rule for a profile that op-mint no longer has
  | .permissions.allow -= ["Bash(op-mint hq)"]
  # agents use the saved gh login and the default git SSH key, so drop the
  # machine-user token and key override that agent-identity or an earlier render wrote
  | del(.env.GH_TOKEN, .env.GITHUB_TOKEN, .env.GIT_SSH_COMMAND)
{{- end }}
{{- if not (and (hasKey . "personal") .personal) }}
  # op-mint is not installed here, so drop the rules an earlier render added
  | if (.permissions.allow | type) == "array"
    then .permissions.allow |= map(select((type == "string" and startswith("Bash(op-mint ")) | not))
    else . end
{{- end }}'
