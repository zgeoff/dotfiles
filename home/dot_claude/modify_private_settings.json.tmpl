#!/bin/sh
# chezmoi owns the keys below and deep-merges them over the live file. Every
# other key stays as Claude Code or a script wrote it: env.OP_SERVICE_ACCOUNT_TOKEN
# (rotated weekly by op-mint), env.GITHUB_TOKEN, and permissions. On a personal machine, chezmoi owns autoMode in full: edit
# .chezmoitemplates/claude/automode.json.age with `chezmoi decrypt`/`chezmoi encrypt`,
# not the live file (an /auto-mode-setup run there is overwritten on the next apply).
# Removing a key here does not remove it from the live file.
set -eu
current=$(cat)
[ -n "$current" ] || current='{}'
automode=null
{{- if and (hasKey . "personal") .personal }}
# A heredoc, not the quoted JSON below: the rules contain apostrophes.
automode=$(cat <<'AUTOMODE'
{{ joinPath .chezmoi.sourceDir ".chezmoitemplates/claude/automode.json.age" | include | decrypt | trim }}
AUTOMODE
)
{{- end }}
printf '%s' "$current" | jq --indent 2 --argjson automode "$automode" --argjson owned '
{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash \"{{ .chezmoi.homeDir }}/.claude/statusline.sh\"",
    "padding": 2
  },
  "outputStyle": "STE Direct",
  "feedbackDrafts": "off",
  "effortLevel": "high",
  "autoCompactWindow": 500000,
  "tui": "fullscreen",
  "editorMode": "vim",
  "skipWorkflowUsageWarning": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
{{- if and (hasKey . "personal") .personal }},
  "advisorModel": "fable",
  "enabledPlugins": {
    "codex-image@codex-image-in-cc": true
  },
  "extraKnownMarketplaces": {
    "codex-image-in-cc": {
      "source": { "source": "github", "repo": "KingGyuSuh/codex-image-in-cc" }
    }
  }
{{- end }}
}' '. * $owned
  | if $automode != null then .autoMode = $automode else . end
  # agents use the default git SSH key, so drop any override an earlier render wrote
  | del(.env.GIT_SSH_COMMAND)
{{- if not (and (hasKey . "personal") .personal) }}
  # drop the personal-only keys a previous personal render left behind
  | del(.advisorModel)
  | del(.enabledPlugins["codex-image@codex-image-in-cc"])
  | del(.extraKnownMarketplaces["codex-image-in-cc"])
{{- end }}'
